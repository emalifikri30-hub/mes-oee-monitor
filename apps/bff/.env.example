# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.
#
#   cp apps/bff/.env.example apps/bff/.env
#
# The BFF is the browser's only backend. It holds the OIDC session in a cookie,
# swaps that cookie for a bearer token, and proxies to the API — so the SPA never
# sees a token. Everything below is required unless marked optional.

NODE_ENV="development"
PORT="3001"

# --- OIDC / Keycloak (authorization-code flow with PKCE) ---
#
# The browser-facing client. It must be a CONFIDENTIAL client (the secret below
# is used for the code exchange) with the redirect URI registered in Keycloak.
#
# NOTE: this must be THIS product's own client, and the value must match the
# api's AUTH_ALLOWED_AZP entry for the browser flow — `azp` on the token the
# proxy forwards is exactly this client_id, so a mismatch 401s every request.
OIDC_CLIENT_ID=mes-oee-monitor
OIDC_CLIENT_SECRET=your-client-secret
OIDC_BASE_URI=https://identity.example.test/realms/your-realm
# Must match a Valid Redirect URI on the client above, exactly.
OIDC_REDIRECT_URI=http://localhost:3001/api/callback
OIDC_CLIENT_SCOPE="openid profile email"

# --- Session cookie ---
# COOKIE_NAME is a prefix: the access token is stored as `<COOKIE_NAME>_access_token`,
# which is also what @molca/mes's cookieToken() extractor reads.
COOKIE_NAME=ms_sess
# Used to sign the session cookie. Generate a fresh one per environment:
#   openssl rand -base64 32
COOKIE_SECRET=generate-me
#
# Optional. A Domain widens the cookie from host-only to the domain and all its
# subdomains, which is what lets the SPA origin and the BFF origin share one
# session. Must be a bare dotted host — no scheme, port or path. The browser
# rejects "localhost" and bare IPs, so leave this unset for local development.
# COOKIE_DOMAIN=.example.test
#
# Optional, default "lax". One of lax | strict | none.
# Cross-site setups (SPA and BFF on different sites) need "none", which browsers
# only honour on a Secure cookie — the loader refuses none+insecure at boot
# rather than letting the browser silently drop every session.
# COOKIE_SAMESITE=lax
#
# Optional. Defaults to true when CLIENT_BASE_REDIRECT_URI is https, else false.
# COOKIE_SECURE=false

# --- Redirects ---
# Where the user lands after a successful login. Must be an absolute URL; its
# scheme also decides the COOKIE_SECURE default above. Also the origin the BFF
# treats as "the SPA" when sanitising return paths against open redirects.
CLIENT_BASE_REDIRECT_URI=http://localhost:3000/

# --- Upstream API ---
# The api app. A trailing slash is stripped at load.
CORE_API_BASE_URL=http://localhost:3002
# Comma-separated allowlist of path prefixes the proxy will forward. Each entry
# must start with '/'. Anything outside these prefixes is refused, so this is the
# blast radius of the proxy — keep it as narrow as the SPA actually needs.
# The api mounts its routes under /api/v1 (see apps/api/src/cmd/api/app.ts).
PROXY_ALLOWED_PREFIXES=/api/v1,/health
# Optional, default 30000. Per-request budget for the upstream call; on expiry
# the proxy answers 504 rather than hanging the browser.
# PROXY_UPSTREAM_TIMEOUT_MS=30000

# --- Service identity ---
# Tenancy discriminator. Must match the api's REGION_CODE, or the SPA will read
# from a different tenant than the one it authenticated against.
REGION_CODE=ap3

# Optional. Comma-separated; defaults to http://localhost:3000 when unset.
CORS_ALLOWED_ORIGINS=http://localhost:3000
