      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(downtime_reason_groups_bucket[$__rate_interval])))",
          "legendFormat": "p99",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
