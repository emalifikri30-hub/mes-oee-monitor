    {
      "id": 108,
      "type": "timeseries",
      "title": "Reports rendering with nothing loaded",
      "description": "EVERY ONE OF THESE IS A 200. The screen says 'not loaded yet' rather than claiming a clean shift \u2014 which is honest but still shows a supervisor an empty card. reject and downtime-event lines are EXPECTED to be non-zero until contract 3.8 and 3.9 populate their tables.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(product_count_empty_total[$__rate_interval]))",
          "legendFormat": "product count (SKU View)",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(perf_hour_empty_total[$__rate_interval]))",
          "legendFormat": "perf hours (Performance Loss)",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(reject_reason_empty_total[$__rate_interval]))",
          "legendFormat": "rejects (Quality Loss)",
          "range": true,
          "refId": "A"
