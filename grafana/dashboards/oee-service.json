    {
      "id": 109,
      "type": "timeseries",
      "title": "Distinct downtime reasons per shift (p99)",
      "description": "/downtimes/by-reason is UNPAGED and the browser holds the whole response \u2014 bounded by construction at work-unit grain, and not bounded at line or area grain. This is the signal that widening it (TODOS.md 25) is becoming necessary.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
